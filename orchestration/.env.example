# Copy to .env (not versioned). Build the image first:
#   docker build -t bike-airflow:3.3.2 -f orchestration/Dockerfile .   (from the repo root)
AIRFLOW_UID=1000
AIRFLOW_IMAGE_NAME=bike-airflow:3.3.2
GCP_PROJECT_ID=your-project-id
GCS_BUCKET=your-project-id-raw
FERNET_KEY=generate-with-openssl-rand-base64-32
